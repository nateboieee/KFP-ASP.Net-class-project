<footer class="kfp-footer">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-4">
                <h5 class="kfp-footer-heading">KFP</h5>
                <p class="text-white-50">Finger Lickin' Pork since forever. A juicy parody brand for demo purposes only — not affiliated with any real fried chicken chain.</p>
            </div>
            <div class="col-md-4">
                <h5 class="kfp-footer-heading">Explore</h5>
                <ul class="list-unstyled">
                    <li><a asp-controller="Menu" asp-action="Index">Full Menu</a></li>
                    <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5 class="kfp-footer-heading">Visit Us</h5>
                <p class="text-white-50 mb-0">123 Crispy Lane<br />Pork City, PC 11111</p>
                <p class="text-white-50">Open daily 10am – 11pm</p>
            </div>
        </div>
        <hr class="border-light opacity-25" />
        <p class="text-center text-white-50 mb-0">&copy; @DateTime.Now.Year - KFP - Kentucky Fried Pork (parody brand, for demo purposes)</p>
    </div>
