@model List<Order>
@{
    ViewData["Title"] = "Manage Orders";
    var statuses = Enum.GetValues(typeof(OrderStatus)).Cast<OrderStatus>();
}

<section class="container py-5">
    <h1 class="kfp-section-title">Manage Orders</h1>

    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>#@o.Id</td>
                        <td>@(o.User?.FullName ?? o.User?.Email ?? "Unknown")</td>
                        <td>@o.OrderDate.ToString("MMM d, h:mm tt")</td>
                        <td>@o.OrderItems.Sum(i => i.Quantity) item(s)</td>
                        <td>$@o.TotalAmount.ToString("0.00")</td>
                        <td>
                            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                <input type="hidden" name="orderId" value="@o.Id" />
                                <select name="status" class="form-select form-select-sm">
                                    @foreach (var s in statuses)
                                    {
                                        if (s == o.Status)
                                        {
                                            <option value="@s" selected>@s</option>
                                        }
                                        else
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-kfp-outline">Update</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
