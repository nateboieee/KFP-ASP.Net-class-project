@model List<MenuItem>
@{
    ViewData["Title"] = "Manage Menu Items";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="kfp-section-title mb-0">Manage Menu Items</h1>
        <a asp-action="CreateItem" class="btn btn-kfp">+ Add Item</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead>
                <tr>
                    <th></th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Available</th>
                    <th>Featured</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-size:1.5rem;">@item.Icon</td>
                        <td>@item.Name</td>
                        <td>@item.MenuCategory?.Name</td>
                        <td>$@item.Price.ToString("0.00")</td>
                        <td>@(item.IsAvailable ? "✅" : "❌")</td>
                        <td>@(item.IsFeatured ? "⭐" : "")</td>
                        <td class="text-end">
                            <a asp-action="EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-kfp-outline">Edit</a>
                            <form asp-action="DeleteItem" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @item.Name?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
