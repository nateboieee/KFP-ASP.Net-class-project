@{
    ViewData["Title"] = "Contact Us";
}

<section class="container py-5">
    <h1 class="kfp-section-title">Contact Us</h1>
    <div class="row g-5">
        <div class="col-md-6">
            <div class="kfp-total-box">
                <h5 class="fw-bold">Get in touch</h5>
                <p>📍 123 Crispy Lane, Pork City, PC 11111</p>
                <p>📞 1-800-KFP-PORK</p>
                <p>✉️ hello@kfp.example</p>
                <p>🕑 Open daily, 10am – 11pm</p>
            </div>
        </div>
        <div class="col-md-6">
            <form>
                <div class="mb-3">
                    <label class="form-label">Your Name</label>
                    <input type="text" class="form-control" placeholder="Jane Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea class="form-control" rows="4" placeholder="How can we help?"></textarea>
                </div>
                <button type="button" class="btn btn-kfp" disabled title="Demo form - not wired up">Send Message</button>
                <p class="text-muted small mt-2">(This demo form isn't wired to send email.)</p>
            </form>
        </div>
    </div>
</section>
