@model List<CartItem>
@{
    ViewData["Title"] = "Your Bucket";
    var total = Model.Sum(i => i.LineTotal);
}

<section class="container py-5">
    <h1 class="kfp-section-title">Your Bucket 🛒</h1>

    @if (!Model.Any())
    {
        <p class="text-muted">Your bucket is empty. <a asp-controller="Menu" asp-action="Index">Go grab something crispy.</a></p>
    }
    else
    {
        <div class="row g-5">
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    <div class="kfp-cart-row d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <span style="font-size:2rem;">@item.Icon</span>
                            <div>
                                <div class="fw-bold">@item.Name</div>
                                <div class="text-muted small">$@item.Price.ToString("0.00") each</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="20" class="form-control form-control-sm" style="width: 70px;" />
                                <button type="submit" class="btn btn-sm btn-kfp-outline">Update</button>
                            </form>
                            <span class="fw-bold kfp-price">$@item.LineTotal.ToString("0.00")</span>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">✕</button>
                            </form>
                        </div>
                    </div>
                }
                <form asp-controller="Cart" asp-action="Clear" method="post" class="mt-3">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Clear Bucket</button>
                </form>
            </div>
            <div class="col-lg-4">
                <div class="kfp-total-box">
                    <h5 class="fw-bold">Order Summary</h5>
                    <div class="d-flex justify-content-between">
                        <span>Subtotal</span>
                        <span>$@total.ToString("0.00")</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span>$@total.ToString("0.00")</span>
                    </div>
                    <a asp-controller="Orders" asp-action="Checkout" class="btn btn-kfp w-100 mt-3">Checkout</a>
                </div>
            </div>
        </div>
    }
</section>
